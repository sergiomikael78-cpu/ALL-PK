<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface">

    <!-- CS Quick Action Strip (Bilah Pintas Atas Keyboard) -->
    <LinearLayout
        android:id="@+id/cs_quick_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_core"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Logo / Status Badge -->
        <TextView
            android:id="@+id/tv_keyboard_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ PK"
            android:textColor="@color/cyber_cyan"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingEnd="8dp" />

        <!-- Dynamic Candidates / Category Pills Container -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidates_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- Pills will be inserted dynamically at runtime -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Tombol Voice Keyboard (Capsule Pill Menonjol dengan Jarak Aman) -->
        <ImageView
            android:id="@+id/btn_voice_input"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_voice_pill"
            android:contentDescription="Ketik dengan Suara (Voice)"
            android:src="@drawable/ic_mic" />

        <!-- Tombol Bersihkan Kolom Input (1x Klik Hapus Bersih) -->
        <ImageView
            android:id="@+id/btn_clear_input"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Bersihkan Kolom"
            android:src="@drawable/ic_clear_all" />

        <!-- Switch / Settings Icon -->
        <ImageView
            android:id="@+id/btn_open_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:contentDescription="Pengaturan"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- Standard Android Keyboard View -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:keyBackground="@color/bg_key"
        android:keyTextColor="@color/text_primary"
        android:keyTextSize="18sp"
        android:keyPreviewLayout="@layout/key_preview_bubble"
        android:keyPreviewOffset="10dp"
        android:keyPreviewHeight="64dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp" />

</LinearLayout>
